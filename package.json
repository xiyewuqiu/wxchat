{
  "name": "wxchat",
  "private": true,
  "version": "2.0.0",
  "description": "微信文件传输助手 Web 应用 - React + Vite 全栈重构版",
  "type": "module",
  "main": "worker/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p worker/tsconfig.json",
    "worker:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:init": "wrangler d1 execute wxchat --file=./database/schema.sql"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "hono": "^4.13.12",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  },
  "keywords": [
    "cloudflare-workers",
    "hono",
    "react",
    "vite",
    "file-transfer",
    "pwa"
  ],
  "author": "xiyewuqiu <xiyewuqiu@gmail.com>",
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
